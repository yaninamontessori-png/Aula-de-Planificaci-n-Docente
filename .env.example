# =============================================================================
# Variables de entorno — Aula de Planificación Docente
# Copiá este archivo como `.env.local` y completá los valores reales.
# NUNCA subas `.env.local` al repositorio (está ignorado en .gitignore).
# =============================================================================

# --- Públicas (visibles en el navegador) -------------------------------------
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Clave "publishable" (nuevo esquema de claves de Supabase, reemplaza a anon).
# Es segura para el navegador: RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública del sitio (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Solo servidor / entornos seguros (NUNCA con prefijo NEXT_PUBLIC) --------
# Clave "secret" (reemplaza a service_role). Omite RLS: solo backend/scripts.
# La usan el script de importación curricular y tareas administrativas.
SUPABASE_SERVICE_ROLE_KEY=

# Clave de Gemini. Se guarda como SECRET de la Edge Function en Supabase,
# no en el frontend. Solo se lista aquí para pruebas locales de la función.
GEMINI_API_KEY=
